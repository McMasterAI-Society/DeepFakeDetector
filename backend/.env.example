# DeepFake Detector Backend - Environment Variables
# Copy this file to .env and update with your values

# Production model: foundation-probe (default) or legacy-fusion (rollback / A/B)
MODEL_MODE=foundation-probe
# Load the legacy fusion if the probe fails to load
MODEL_FALLBACK_TO_LEGACY=true
# Foundation-probe head repo (config.json + head.npz); backbones come from pinned timm repos
HF_PROBE_REPO_ID=DeepFakeDetector/fm-probe-clip-dinov3
# HF_PROBE_REVISION=<commit-sha>          # overrides model-manifest.json "probe.revision"
# Test before upload: directory produced by `python -m app.scripts.export_probe_head`
# PROBE_LOCAL_PATH=/path/to/export
# Optional: dir with <key>.fp16.safetensors or <key>.fp16.pt backbones (skips the upstream download)
# PROBE_BACKBONE_DIR=/path/to/weights
# PROBE_DEVICE=auto                       # auto | cuda | cpu
# PROBE_VERDICT_BANDS=0.2,0.7             # real < 0.2 <= inconclusive < 0.7 <= ai (default: config.json)
# PROBE_EXPLAIN_ON_PREDICT=false          # heatmaps on /predict; otherwise via POST /explain

# Hugging Face Configuration (legacy fusion)
# Available fusion models:
#   - DeepFakeDetector/fusion-logreg-final (Logistic Regression - default)
#   - DeepFakeDetector/fusion-meta-final (Meta-classifier)
HF_FUSION_REPO_ID=DeepFakeDetector/fusion-logreg-final
# Optional: pin the fusion repo to a commit sha (overrides model-manifest.json)
# HF_FUSION_REVISION=<commit-sha>
# Optional: manifest pinning repo revisions (default: backend/model-manifest.json if present)
# MODEL_MANIFEST_PATH=./model-manifest.json
# Optional: gradient-field CNN weights file. Unset keeps gradient_field_cnn_v3_finetuned.pth.
# GRADFIELD_WEIGHTS_FILE=gradient_field_cnn_v2.pth
HF_CACHE_DIR=.hf_cache
HF_HOME=.cache/huggingface
HF_PERSISTENT_CACHE=true
HF_PERSISTENT_CACHE_ROOT=/data
HF_BUCKET_URI=hf://buckets/<username>/<bucket-name>
HF_BUCKET_LOCAL_DIR=./data
HF_BUCKET_DELETE=false
HF_BUCKET_SYNC_ON_DEPLOY=true
# HF_TOKEN=your_huggingface_token_here  # Optional: for private repos

# HF Spaces Deployment Configuration (used by deploy-to-hf.sh)
HF_SPACE_URL=https://huggingface.co/spaces/<username>/<space-name>
HF_SPACE_WEB_URL=https://huggingface.co/spaces/<username>/<space-name>
HF_SPACE_APP_URL=https://<username>-<space-name>.hf.space
# Use your prebuilt dependency base image for faster deploys.
# Example tag format: ghcr.io/your-github-username/deepfake-detector-backend-base:latest
HF_BASE_IMAGE=ghcr.io/your-github-username/deepfake-detector-backend-base:latest
# Fallback if you don't use a prebuilt base image:
# HF_BASE_IMAGE=python:3.11-slim
INSTALL_OPTIONAL_DEPS=false
# For Linux/macOS/Git-Bash:
HF_DEPLOY_DIR=/tmp/hf-deployment/DeepFakeDetectorBackend
# For PowerShell-style .env values, this is also accepted and normalized by deploy-to-hf.sh:
# HF_DEPLOY_DIR=$TEMP\hf-deployment\DeepFakeDetectorBackend

# Google Gemini API (Optional - for LLM explanations)
# GOOGLE_API_KEY=your_google_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:8082,https://www.deepfake-detector.app,https://deepfake-detector.app

# Debugging
ENABLE_DEBUG=false
LOG_LEVEL=INFO
